digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.6, ranksep=0.7, pad=0.5, fontname="Liberation Sans", newrank=true, bgcolor="white"];
  node  [fontname="Liberation Sans", fontsize=12, penwidth=1, color="#333333", style=filled, fillcolor="#FFFFFF"];
  edge  [penwidth=1, arrowsize=0.7, color="#333333", fontname="Liberation Sans", fontsize=11];
  s [shape=box, style="rounded,filled", fillcolor="#F8F9FA", width=1.4, height=0.55, label="Start"];
  open [shape=box, margin="0.30,0.18", label="Open AniHow: Android application\nor content management panel"];
  acct [shape=diamond, margin="0.24,0.12", label="Has an\naccount?"];
  reg [shape=parallelogram, fillcolor="#F8F9FA", margin="0.34,0.16", label="Register as a buyer\n(name, email, password)"];
  code [shape=parallelogram, fillcolor="#F8F9FA", margin="0.34,0.16", label="Receive six-digit\ncode by email"];
  valid [shape=diamond, margin="0.24,0.12", label="Code correct and\nwithin ten minutes?"];
  resend [shape=box, margin="0.30,0.18", label="Request a\nnew code"];
  login [shape=parallelogram, fillcolor="#F8F9FA", margin="0.34,0.16", label="Enter email\nand password"];
  ok [shape=diamond, margin="0.24,0.12", label="Credentials valid and\naccount active?"];
  err [shape=box, margin="0.30,0.18", label="Show error\nmessage"];
  role [shape=diamond, margin="0.24,0.12", label="Role of\nthe user?"];
  sa [shape=box, margin="0.30,0.18", label="Super Admin dashboard\n(content management panel)"];
  ce [shape=box, margin="0.30,0.18", label="Content Editor dashboard\n(own farm only)"];
  fs [shape=box, margin="0.30,0.18", label="Farmer-seller home\n(Android application)"];
  by [shape=box, margin="0.30,0.18", label="Buyer marketplace\n(Android application)"];
  A [shape=circle, width=0.52, fixedsize=true, fillcolor="#F8F9FA", label="A"];
  B [shape=circle, width=0.52, fixedsize=true, fillcolor="#F8F9FA", label="B"];
  C [shape=circle, width=0.52, fixedsize=true, fillcolor="#F8F9FA", label="C"];
  D [shape=circle, width=0.52, fixedsize=true, fillcolor="#F8F9FA", label="D"];
  tasks [shape=box, margin="0.30,0.18", label="Perform role tasks\n(Figures 6 to 9)"];
  out [shape=diamond, margin="0.24,0.12", label="Log out?"];
  end [shape=box, style="rounded,filled", fillcolor="#F8F9FA", width=1.4, height=0.55, label="End"];
  s -> open;
  open -> acct;
  acct -> reg [xlabel="No"];
  reg -> code;
  code -> valid;
  valid -> resend [xlabel="No"];
  resend -> code [constraint=false];
  valid -> login [xlabel="Yes"];
  acct -> login [xlabel="Yes"];
  login -> ok;
  ok -> err [xlabel="No"];
  err -> login [constraint=false];
  ok -> role [xlabel="Yes"];
  role -> sa [xlabel="Super Admin"];
  role -> ce [xlabel="Content Editor"];
  role -> fs [xlabel="Farmer-seller"];
  role -> by [xlabel="Buyer"];
  sa -> A;
  ce -> B;
  fs -> C;
  by -> D;
  A -> tasks;
  B -> tasks;
  C -> tasks;
  D -> tasks;
  tasks -> out;
  out -> tasks [xlabel="No", constraint=false];
  out -> end [xlabel="Yes"];
  {rank=same; sa; ce; fs; by}
  {rank=same; A; B; C; D}
  s [group=spine];
  open [group=spine];
  acct [group=spine];
  login [group=spine];
  ok [group=spine];
  role [group=spine];
  tasks [group=spine];
  out [group=spine];
  end [group=spine];
}
