// Data flow diagram, level 1 (processes 5.0 to 8.0).
digraph G {
  graph [rankdir=LR, nodesep=0.25, ranksep=0.9, pad=0.25, fontname="Liberation Sans", newrank=true];
  node  [fontname="Liberation Sans", fontsize=11];
  edge  [penwidth=0.9, arrowsize=0.6, color="#333333", fontname="Liberation Sans", fontsize=8.5];
  p5 [shape=circle, style=filled, fillcolor="#F4F4F4", penwidth=1.4, fixedsize=true, width=1.35, fontsize=10.5, label="5.0\n\nCoordinate\nOrders and\nNotify"];
  by_p5 [shape=box, style=filled, fillcolor="#E8E6E0", penwidth=1.2, width=1.35, height=0.42, label="Buyer*"];
  fs_p5 [shape=box, style=filled, fillcolor="#E8E6E0", penwidth=1.2, width=1.35, height=0.42, label="Farmer-Seller*"];
  sa_p5 [shape=box, style=filled, fillcolor="#E1E6ED", penwidth=1.2, width=1.35, height=0.42, label="Super Admin*"];
  D7_p5 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D7</B></TD><TD SIDES="TB" ALIGN="LEFT">Order Messages</TD></TR></TABLE>>];
  D8_p5 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D8</B></TD><TD SIDES="TB" ALIGN="LEFT">Notifications*</TD></TR></TABLE>>];
  D6_p5 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D6</B></TD><TD SIDES="TB" ALIGN="LEFT">Orders*</TD></TR></TABLE>>];
  p6 [shape=circle, style=filled, fillcolor="#F4F4F4", penwidth=1.4, fixedsize=true, width=1.35, fontsize=10.5, label="6.0\n\nManage Farm\nContent and\nHelp"];
  by_p6 [shape=box, style=filled, fillcolor="#E8E6E0", penwidth=1.2, width=1.35, height=0.42, label="Buyer*"];
  fs_p6 [shape=box, style=filled, fillcolor="#E8E6E0", penwidth=1.2, width=1.35, height=0.42, label="Farmer-Seller*"];
  sa_p6 [shape=box, style=filled, fillcolor="#E1E6ED", penwidth=1.2, width=1.35, height=0.42, label="Super Admin*"];
  D8_p6 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D8</B></TD><TD SIDES="TB" ALIGN="LEFT">Notifications*</TD></TR></TABLE>>];
  ce_p6 [shape=box, style=filled, fillcolor="#E1E6ED", penwidth=1.2, width=1.35, height=0.42, label="Content Editor*"];
  sch_p6 [shape=box, style=filled, fillcolor="#F2F2F2", penwidth=1.2, width=1.35, height=0.42, label="Scheduler"];
  D2_p6 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D2</B></TD><TD SIDES="TB" ALIGN="LEFT">Farms</TD></TR></TABLE>>];
  D11_p6 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D11</B></TD><TD SIDES="TB" ALIGN="LEFT">Crop-Care Articles</TD></TR></TABLE>>];
  D12_p6 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D12</B></TD><TD SIDES="TB" ALIGN="LEFT">Farm Announcements</TD></TR></TABLE>>];
  D13_p6 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D13</B></TD><TD SIDES="TB" ALIGN="LEFT">FAQ Entries</TD></TR></TABLE>>];
  p7 [shape=circle, style=filled, fillcolor="#F4F4F4", penwidth=1.4, fixedsize=true, width=1.35, fontsize=10.5, label="7.0\n\nReport\nAnalytics and\nExports"];
  fs_p7 [shape=box, style=filled, fillcolor="#E8E6E0", penwidth=1.2, width=1.35, height=0.42, label="Farmer-Seller*"];
  sa_p7 [shape=box, style=filled, fillcolor="#E1E6ED", penwidth=1.2, width=1.35, height=0.42, label="Super Admin*"];
  D6_p7 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D6</B></TD><TD SIDES="TB" ALIGN="LEFT">Orders*</TD></TR></TABLE>>];
  ce_p7 [shape=box, style=filled, fillcolor="#E1E6ED", penwidth=1.2, width=1.35, height=0.42, label="Content Editor*"];
  D14_p7 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D14</B></TD><TD SIDES="TB" ALIGN="LEFT">Export Logs</TD></TR></TABLE>>];
  p8 [shape=circle, style=filled, fillcolor="#F4F4F4", penwidth=1.4, fixedsize=true, width=1.35, fontsize=10.5, label="8.0\n\nHandle\nData Rights"];
  by_p8 [shape=box, style=filled, fillcolor="#E8E6E0", penwidth=1.2, width=1.35, height=0.42, label="Buyer*"];
  fs_p8 [shape=box, style=filled, fillcolor="#E8E6E0", penwidth=1.2, width=1.35, height=0.42, label="Farmer-Seller*"];
  sa_p8 [shape=box, style=filled, fillcolor="#E1E6ED", penwidth=1.2, width=1.35, height=0.42, label="Super Admin*"];
  D8_p8 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D8</B></TD><TD SIDES="TB" ALIGN="LEFT">Notifications*</TD></TR></TABLE>>];
  D6_p8 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D6</B></TD><TD SIDES="TB" ALIGN="LEFT">Orders*</TD></TR></TABLE>>];
  D15_p8 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D15</B></TD><TD SIDES="TB" ALIGN="LEFT">Deletion Requests</TD></TR></TABLE>>];
  D1_p8 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D1</B></TD><TD SIDES="TB" ALIGN="LEFT">Users and Roles</TD></TR></TABLE>>];
  em_p8 [shape=box, style=filled, fillcolor="#F2F2F2", penwidth=1.2, width=1.35, height=0.42, label="Email Service"];
  by_p5 -> p5 [label="chat messages,\nread marks"];
  fs_p5 -> p5 [label="chat messages,\nread marks"];
  by_p5 -> p5 [label="messages,\nnotifications", dir=back];
  fs_p5 -> p5 [label="messages,\nnotifications", dir=back];
  sa_p5 -> p5 [label="chat threads\n(read only)", dir=back];
  p5 -> D7_p5 [label="messages"];
  p5 -> D7_p5 [label="threads", dir=back];
  p5 -> D8_p5 [label="notifications", dir=back];
  p5 -> D8_p5 [label="read status"];
  p5 -> D6_p5 [label="order parties", dir=back];
  ce_p6 -> p6 [label="profile, photos, articles,\nannouncements, farm answers"];
  sa_p6 -> p6 [label="system answers,\nmoderation"];
  fs_p6 -> p6 [label="questions"];
  by_p6 -> p6 [label="questions"];
  fs_p6 -> p6 [label="articles, announcements,\nanswers", dir=back];
  by_p6 -> p6 [label="answers", dir=back];
  ce_p6 -> p6 [label="moderation notices", dir=back];
  sch_p6 -> p6 [label="five-minute check"];
  p6 -> D2_p6 [label="profile, photos"];
  p6 -> D11_p6 [label="articles"];
  p6 -> D11_p6 [label="published articles", dir=back];
  p6 -> D12_p6 [label="announcements"];
  p6 -> D12_p6 [label="due announcements", dir=back];
  p6 -> D13_p6 [label="answers"];
  p6 -> D13_p6 [label="matching answers", dir=back];
  p6 -> D8_p6 [label="announcement notices"];
  p7 -> D6_p7 [label="completed orders", dir=back];
  sa_p7 -> p7 [label="system analytics,\nCSV exports, export log", dir=back];
  ce_p7 -> p7 [label="farm analytics", dir=back];
  fs_p7 -> p7 [label="My Sales", dir=back];
  sa_p7 -> p7 [label="export requests"];
  p7 -> D14_p7 [label="export entries"];
  p7 -> D14_p7 [label="export history", dir=back];
  by_p8 -> p8 [label="corrections, download\nand deletion requests"];
  fs_p8 -> p8 [label="corrections, download\nand deletion requests"];
  sa_p8 -> p8 [label="deletion decisions"];
  sa_p8 -> p8 [label="pending requests", dir=back];
  by_p8 -> p8 [label="own data export", dir=back];
  fs_p8 -> p8 [label="own data export", dir=back];
  p8 -> D15_p8 [label="requests, decisions"];
  p8 -> D15_p8 [label="request status", dir=back];
  p8 -> D1_p8 [label="corrections,\nanonymization"];
  p8 -> D1_p8 [label="profile", dir=back];
  p8 -> D6_p8 [label="orders, open orders check", dir=back];
  p8 -> D8_p8 [label="request and\nrejection notices"];
  em_p8 -> p8 [label="deletion notices", dir=back];
  {rank=same; by_p5; fs_p5; sa_p5; ce_p6; sa_p6; fs_p6; by_p6; sch_p6; sa_p7; ce_p7; fs_p7; by_p8; fs_p8; sa_p8; em_p8}
  {rank=same; D7_p5; D8_p5; D6_p5; D2_p6; D11_p6; D12_p6; D13_p6; D8_p6; D6_p7; D14_p7; D15_p8; D1_p8; D6_p8; D8_p8}
  {rank=same; p5; p6; p7; p8}
  p5 -> p6 [style=invis, weight=10];
  p6 -> p7 [style=invis, weight=10];
  p7 -> p8 [style=invis, weight=10];
}
