// Figure 7. Entity relationship diagram of AniHow (v3.5). Generated by gen_fig7.py; edit that file, not this one.
digraph G {
  graph [rankdir=LR, nodesep=0.35, ranksep=1.0, pad=0.3, fontname="Liberation Sans", splines=true];
  node  [shape=plain, fontname="Liberation Sans", fontsize=11];
  edge  [arrowhead=none, penwidth=1.1, color="#333333", fontname="Liberation Sans", fontsize=10, labelfontsize=10];
  farm [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E1E6ED"><B>Farm</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">name</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">pickup_point</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">contact_number</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">is_active</TD></TR></TABLE>>];
  user [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E1E6ED"><B>User</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK farm_id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">name, email, phone</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">status (role via Spatie)</TD></TR></TABLE>>];
  crop [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E1E6ED"><B>Crop Type</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">label_en, label_fil</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">unit_of_measure</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">floor_price</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">max_discount</TD></TR></TABLE>>];
  ovr [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8E6E0"><B>Farm Price Override</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK farm_id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK crop_type_id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">floor_price, max_discount</TD></TR></TABLE>>];
  photo [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8E6E0"><B>Farm Photo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK farm_id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">path, caption</TD></TR></TABLE>>];
  ann [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8E6E0"><B>Farm Announcement</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK farm_id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK author_id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">audience, starts_at,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">ends_at, notified_at</TD></TR></TABLE>>];
  faq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8E6E0"><B>FAQ Entry</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK farm_id (null = system)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">intent_key, roles</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">answer, answer_fil</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">moderated_at</TD></TR></TABLE>>];
  art [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8E6E0"><B>Crop-Care Article</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK farm_id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">title, status</TD></TR></TABLE>>];
  lst [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8E6E0"><B>Listing</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK farmer_seller_id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK farm_id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK crop_type_id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">price_per_unit</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">quantity_available,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">quantity_held</TD></TR></TABLE>>];
  tawad [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8E6E0"><B>Tawad Rule</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK listing_id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">type, discount_amount,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">min_quantity</TD></TR></TABLE>>];
  ord [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8E6E0"><B>Order</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK buyer_id (null = walk-in)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK farmer_seller_id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK farm_id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">source, status</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">total, amount_received</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">reminder_sent_at</TD></TR></TABLE>>];
  item [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8E6E0"><B>Order Item</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK order_id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK listing_id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">quantity, unit_price,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">tawad_amount</TD></TR></TABLE>>];
  msg [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8E6E0"><B>Order Message</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK order_id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK user_id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">body</TD></TR></TABLE>>];
  rev [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8E6E0"><B>Review</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK order_id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK buyer_id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK farmer_seller_id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">rating, comment</TD></TR></TABLE>>];
  exp [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8E6E0"><B>Export Log</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK user_id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">type, filters, row_count</TD></TR></TABLE>>];
  del [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8E6E0"><B>Account Deletion Request</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK user_id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK processed_by</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">status</TD></TR></TABLE>>];
  farm -> user [taillabel="1", headlabel="N", label="members"];
  farm -> ovr [taillabel="1", headlabel="N"];
  crop -> ovr [taillabel="1", headlabel="N"];
  farm -> photo [taillabel="1", headlabel="N"];
  farm -> ann [taillabel="1", headlabel="N"];
  farm -> faq [taillabel="1", headlabel="0..N"];
  farm -> art [taillabel="1", headlabel="N", label="writes"];
  crop -> art [taillabel="M", headlabel="N", label="tagged to"];
  user -> lst [taillabel="1", headlabel="N", label="sells"];
  crop -> lst [taillabel="1", headlabel="N"];
  lst -> tawad [taillabel="1", headlabel="N"];
  user -> ord [taillabel="1", headlabel="N", label="places / fulfils"];
  ord -> item [taillabel="1", headlabel="N"];
  lst -> item [taillabel="1", headlabel="N"];
  ord -> msg [taillabel="1", headlabel="N"];
  ord -> rev [taillabel="1", headlabel="0..1"];
  user -> exp [taillabel="1", headlabel="N"];
  user -> del [taillabel="1", headlabel="N"];
  {rank=same; farm; crop}
  {rank=same; user; ovr; art}
}
