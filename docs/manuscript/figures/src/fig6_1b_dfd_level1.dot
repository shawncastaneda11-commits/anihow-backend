  {rank=same; D7_p5; D8_p5; D6_p5; D2_p6; D11_p6; D12_p6; D13_p6; D8_p6; D6_p7; D14_p7; D15_p8; D1_p8; D6_p8; D17_p8; D8_p8; D4_p9; D9_p9; D17_p9; D8_p9}
