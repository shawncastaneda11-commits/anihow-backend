  by_q4g [shape=box, style=filled, fillcolor="#E8E6E0", penwidth=1.2, width=1.35, height=0.46, label="Buyer", comment="gsdup"];
  D6_q4g [shape=plaintext, margin=0, width=0, height=0, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="L" WIDTH="3" CELLPADDING="0"></TD><TD SIDES="TBL" WIDTH="30"><B>D6</B></TD><TD SIDES="TB" ALIGN="LEFT">Orders</TD></TR></TABLE>>];
  fs_q4g [shape=box, style=filled, fillcolor="#E8E6E0", penwidth=1.2, width=1.35, height=0.46, label="Farmer-Seller", comment="gsdup"];
  sa_q4g [shape=box, style=filled, fillcolor="#E1E6ED", penwidth=1.2, width=1.35, height=0.46, label="Super Admin", comment="gsdup"];
  by_q4a -> q4a [label="cart items\n(verified buyers)"];
  q4a -> D4_q4a [label="price, stock", dir=back];
  q4a -> D5_q4a [label="cart items"];
  by_q4b -> q4b [label="checkout, fulfillment\npreference"];
  q4b -> D5_q4b [label="cart", dir=back];
  q4b -> D4_q4b [label="prices, tawad, stock", dir=back];
  q4b -> D2_q4b [label="farm guards", dir=back];
  q4b -> D6_q4b [label="one Placed order\nper seller"];
  q4b -> D4_q4b [label="held stock"];
  q4b -> D8_q4b [label="new order notice"];
  by_q4b -> q4b [label="order summary", dir=back];
  fs_q4c -> q4c [label="confirm, ready, complete\nwith amount, cancel"];
  by_q4c -> q4c [label="cancel while\nPlaced"];
  q4c -> D6_q4c [label="order", dir=back];
  q4c -> D6_q4c [label="status, history,\nfixed prices"];
  q4c -> D4_q4c [label="deduct, release,\nrestore stock"];
  q4c -> D8_q4c [label="status and\nlow-stock notices"];
  em_q4c -> q4c [label="low-stock alert", dir=back];
  fs_q4d -> q4d [label="walk-in sale,\namount received"];
  q4d -> D4_q4d [label="price, tawad, stock", dir=back];
  q4d -> D6_q4d [label="Completed order,\nno buyer"];
  q4d -> D4_q4d [label="deducted stock"];
  q4d -> D8_q4d [label="low-stock notice"];
  em_q4d -> q4d [label="low-stock alert", dir=back];
  sch_q4e -> q4e [label="hourly trigger"];
  q4e -> D6_q4e [label="Placed orders", dir=back];
  q4e -> D8_q4e [label="12-hour reminder,\ncancellation notice"];
  q4e -> D6_q4e [label="48-hour system\ncancellation"];
  q4e -> D4_q4e [label="released stock"];
  by_q4f -> q4f [label="rating, comment"];
  q4f -> D6_q4f [label="completed app order", dir=back];
  q4f -> D9_q4f [label="review"];
  sa_q4f -> q4f [label="review removal"];
  q4g -> D6_q4g [label="orders", dir=back];
  by_q4g -> q4g [label="history, receipts", dir=back];
  fs_q4g -> q4g [label="order list", dir=back];
  sa_q4g -> q4g [label="order ledger", dir=back];
  {rank=same; by_q4a; by_q4b; fs_q4c; by_q4c; em_q4c; fs_q4d; em_q4d; sch_q4e; by_q4f; sa_q4f; by_q4g; fs_q4g; sa_q4g}
  {rank=same; D4_q4a; D5_q4a; D5_q4b; D4_q4b; D2_q4b; D6_q4b; D8_q4b; D6_q4c; D4_q4c; D8_q4c; D4_q4d; D6_q4d; D8_q4d; D6_q4e; D8_q4e; D4_q4e; D6_q4f; D9_q4f; D6_q4g}
  {rank=same; q4a; q4b; q4c; q4d; q4e; q4f; q4g}
  q4a -> q4b [style=invis, weight=10];
  q4b -> q4c [style=invis, weight=10];
  q4c -> q4d [style=invis, weight=10];
  q4d -> q4e [style=invis, weight=10];
  q4e -> q4f [style=invis, weight=10];
  q4f -> q4g [style=invis, weight=10];
}
