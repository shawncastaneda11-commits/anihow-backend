  D11_p6 [shape=plaintext, margin=0, width=0, height=0, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D11</B></TD><TD SIDES="TB" ALIGN="LEFT">Crop-Care Articles</TD></TR></TABLE>>];
