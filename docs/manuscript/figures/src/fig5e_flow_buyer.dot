digraph G {
  graph [rankdir=TB, nodesep=0.22, ranksep=0.22, pad=0.2, fontname="Liberation Sans", newrank=true, splines=ortho];
  node  [fontname="Liberation Sans", fontsize=14, penwidth=1.3, style=filled, fillcolor="#FFFFFF", margin="0.12,0.06"];
  edge  [penwidth=1.1, arrowsize=0.7, color="#333333", fontname="Liberation Sans", fontsize=12];
  s [shape=box, style="rounded,filled", fillcolor="#E1E6ED", label="Start"];
  li [shape=parallelogram, fillcolor="#F2F2F2", label="Log in to the\napp", margin="0.02,0.04"];
  ok [shape=diamond, fillcolor="#F4F4F4", label="Credentials valid\nand account active?", margin="0.02,0.02"];
  err [shape=box, label="Show error message"];
  ain [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  home [shape=box, label="Buyer\nmarketplace"];
  lo [shape=box, label="Log out"];
  end [shape=box, style="rounded,filled", fillcolor="#E1E6ED", label="End"];
  s -> li;
  li -> ok;
  ok -> err [xlabel="No"];
  err -> li [constraint=false];
  ok -> home [xlabel="Yes"];
  ain -> home;
  {rank=same; ok err}
  {rank=same; home ain}
  q0 [shape=diamond, fillcolor="#F4F4F4", label="Browse the\nmarketplace?", margin="0.02,0.02"];
  home -> q0;
  s0_0 [shape=box, label="Search listings, shops,\nand farm pages"];
  q0 -> s0_0 [xlabel="Yes"];
  s0_1 [shape=box, label="Save favorites or\nreport content"];
  s0_0 -> s0_1;
  r0 [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  s0_1 -> r0;
  {rank=same; q0; s0_0; s0_1; r0}
  q1 [shape=diamond, fillcolor="#F4F4F4", label="Place an\norder?", margin="0.02,0.02"];
  q0 -> q1 [xlabel="No"];
  s1_0 [shape=box, label="Add listings\nto the cart"];
  q1 -> s1_0 [xlabel="Yes"];
  s1_1 [shape=diamond, fillcolor="#F4F4F4", label="Email\nverified?", margin="0.02,0.02"];
  s1_0 -> s1_1;
  a1_1 [shape=box, label="Verify email\nwith the code"];
  xa1_1 [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  s1_1 -> a1_1 [xlabel="No"];
  a1_1 -> xa1_1;
  {rank=same; a1_1; xa1_1}
  s1_2 [shape=parallelogram, fillcolor="#F2F2F2", label="Check out: pickup\nor delivery", margin="0.02,0.04"];
  s1_1 -> s1_2 [xlabel="Yes"];
  r1 [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  s1_2 -> r1;
  {rank=same; q1; s1_0; s1_1; s1_2; r1}
  q2 [shape=diamond, fillcolor="#F4F4F4", label="Track an\norder?", margin="0.02,0.02"];
  q1 -> q2 [xlabel="No", minlen=2];
  s2_0 [shape=diamond, fillcolor="#F4F4F4", label="Confirmed within\n48 hours?", margin="0.02,0.02"];
  q2 -> s2_0 [xlabel="Yes"];
  a2_0 [shape=box, label="System cancels;\nstock released"];
  xa2_0 [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  s2_0 -> a2_0 [xlabel="No"];
  a2_0 -> xa2_0;
  {rank=same; a2_0; xa2_0}
  s2_1 [shape=box, label="Hand over, pay\ncash; Completed"];
  s2_0 -> s2_1 [xlabel="Yes"];
  s2_2 [shape=parallelogram, fillcolor="#F2F2F2", label="Leave a\nreview", margin="0.02,0.04"];
  s2_1 -> s2_2;
  r2 [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  s2_2 -> r2;
  {rank=same; q2; s2_0; s2_1; s2_2; r2}
  q3 [shape=diamond, fillcolor="#F4F4F4", label="Need\nhelp?", margin="0.02,0.02"];
  q2 -> q3 [xlabel="No", minlen=2];
  s3_0 [shape=box, label="Ask the\nFAQ helper"];
  q3 -> s3_0 [xlabel="Yes"];
  r3 [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  s3_0 -> r3;
  {rank=same; q3; s3_0; r3}
  q4 [shape=diamond, fillcolor="#F4F4F4", label="Manage\nmy data?", margin="0.02,0.02"];
  q3 -> q4 [xlabel="No"];
  s4_0 [shape=box, label="Correct, download,\nor request deletion"];
  q4 -> s4_0 [xlabel="Yes"];
  r4 [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  s4_0 -> r4;
  {rank=same; q4; s4_0; r4}
  q4 -> lo [xlabel="No"];
  lo -> end;
  s [group=trunk];
  li [group=trunk];
  ok [group=trunk];
  home [group=trunk];
  lo [group=trunk];
  end [group=trunk];
  q0 [group=trunk];
  q1 [group=trunk];
  q2 [group=trunk];
  q3 [group=trunk];
  q4 [group=trunk];
}
