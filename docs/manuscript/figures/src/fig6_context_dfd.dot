// Figure 6. Context diagram (data flow diagram, level 0) of AniHow (v3.5), Gane-Sarson notation.
digraph G {
  graph [rankdir=LR, nodesep=0.7, ranksep=2.2, pad=0.3, fontname="Liberation Sans", newrank=true];
  node  [fontname="Liberation Sans", fontsize=13];
  edge  [penwidth=1.1, arrowsize=0.75, color="#333333", fontname="Liberation Sans", fontsize=10];

  node [shape=box, style="filled", penwidth=1.4, width=1.8, height=0.6];
  sa [label="Super Admin",    fillcolor="#E1E6ED"];
  ce [label="Content Editor", fillcolor="#E1E6ED"];
  fs [label="Farmer-Seller",  fillcolor="#E8E6E0"];
  by [label="Buyer",          fillcolor="#E8E6E0"];
  em [label="Email Service\n(Gmail SMTP)", fillcolor="#F2F2F2"];

  sys [shape=plaintext, style="", fillcolor=none, width=0, height=0, margin=0, label=<<TABLE STYLE="ROUNDED" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#F4F4F4">
       <TR><TD><FONT POINT-SIZE="14">0</FONT></TD></TR><HR/>
       <TR><TD CELLPADDING="14"><FONT POINT-SIZE="15">AniHow<BR/>System</FONT></TD></TR></TABLE>>];

  sa -> sys [label="approvals, system price guards,\ntaxonomy, moderation, system FAQ\nanswers, report and deletion decisions"];
  sys -> sa [label="order ledger, analytics, CSV exports,\ncontent reports, deletion requests"];

  ce -> sys [label="articles, farm profile and photos,\nfarm price guards, announcements,\nfarm FAQ answers"];
  sys -> ce [label="farm roster, farm analytics,\nmoderation notices"];

  sys -> fs [label="orders, crop-care articles, announcements,\nMy Sales figures, chat messages,\nnotifications, FAQ answers, data export"];
  sys -> fs [dir=back, label="listings, tawad rules, order updates,\nwalk-in sales, chat messages, review reports,\nprofile corrections, deletion requests"];

  sys -> by [label="listings, farm pages, order status,\nchat messages, notifications,\nFAQ answers, data export"];
  sys -> by [dir=back, label="registration, orders, cancellations,\nreviews, reports, chat messages, FAQ questions,\nprofile corrections, deletion requests"];

  sys -> em [label="verification codes, password\nresets, deletion notices,\nlow-stock alerts"];

  {rank=same; sa ce}
  {rank=same; fs by em}
}
