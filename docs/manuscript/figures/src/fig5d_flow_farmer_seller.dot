digraph G {
  graph [rankdir=TB, nodesep=0.45, ranksep=0.5, pad=0.2, fontname="Liberation Sans", newrank=true, splines=ortho];
  node  [fontname="Liberation Sans", fontsize=14, penwidth=1.3, style=filled, fillcolor="#FFFFFF", margin="0.12,0.06"];
  edge  [penwidth=1.1, arrowsize=0.7, color="#333333", fontname="Liberation Sans", fontsize=12];
  s [shape=box, style="rounded,filled", fillcolor="#E1E6ED", label="Start"];
  li [shape=parallelogram, fillcolor="#F2F2F2", label="Log in to the\napp", margin="0.02,0.04"];
  ok [shape=diamond, fillcolor="#F4F4F4", label="Credentials valid\nand account active?", margin="0.02,0.02"];
  err [shape=box, label="Show error message"];
  ain [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  home [shape=box, label="Farmer-seller\nhome"];
  lo [shape=box, label="Log out"];
  end [shape=box, style="rounded,filled", fillcolor="#E1E6ED", label="End"];
  s -> li;
  li -> ok;
  ok -> err [xlabel="No"];
  err -> li [constraint=false];
  ok -> home [xlabel="Yes"];
  ain -> home;
  {rank=same; ok err}
  {rank=same; home ain}
  q0 [shape=diamond, fillcolor="#F4F4F4", label="Manage\nlistings?", margin="0.02,0.02"];
  home -> q0;
  s0_0 [shape=parallelogram, fillcolor="#F2F2F2", label="Enter price, stock,\nand photos", margin="0.02,0.04"];
  q0 -> s0_0 [xlabel="Yes"];
  s0_1 [shape=diamond, fillcolor="#F4F4F4", label="At or above\nthe floor?", margin="0.02,0.02"];
  s0_0 -> s0_1;
  a0_1 [shape=box, label="Show the\nfloor price"];
  xa0_1 [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  s0_1 -> a0_1 [xlabel="No"];
  a0_1 -> xa0_1;
  {rank=same; a0_1; xa0_1}
  s0_2 [shape=box, label="Publish with\noptional tawad"];
  s0_1 -> s0_2 [xlabel="Yes"];
  r0 [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  s0_2 -> r0;
  {rank=same; q0; s0_0; s0_1; s0_2; r0}
  q1 [shape=diamond, fillcolor="#F4F4F4", label="Process\norders?", margin="0.02,0.02"];
  q0 -> q1 [xlabel="No", minlen=2];
  s1_0 [shape=diamond, fillcolor="#F4F4F4", label="Accept the\norder?", margin="0.02,0.02"];
  q1 -> s1_0 [xlabel="Yes"];
  a1_0 [shape=box, label="Cancel with reason;\nstock released"];
  xa1_0 [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  s1_0 -> a1_0 [xlabel="No"];
  a1_0 -> xa1_0;
  {rank=same; a1_0; xa1_0}
  s1_1 [shape=box, label="Confirm, mark\nReady, hand over"];
  s1_0 -> s1_1 [xlabel="Yes"];
  s1_2 [shape=parallelogram, fillcolor="#F2F2F2", label="Complete with\namount received", margin="0.02,0.04"];
  s1_1 -> s1_2;
  r1 [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  s1_2 -> r1;
  {rank=same; q1; s1_0; s1_1; s1_2; r1}
  q2 [shape=diamond, fillcolor="#F4F4F4", label="Walk-in\nsale?", margin="0.02,0.02"];
  q1 -> q2 [xlabel="No", minlen=2];
  s2_0 [shape=parallelogram, fillcolor="#F2F2F2", label="Enter listing,\nquantity, amount", margin="0.02,0.04"];
  q2 -> s2_0 [xlabel="Yes"];
  s2_1 [shape=box, label="Saved at\nCompleted"];
  s2_0 -> s2_1;
  r2 [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  s2_1 -> r2;
  {rank=same; q2; s2_0; s2_1; r2}
  q3 [shape=diamond, fillcolor="#F4F4F4", label="View My\nSales?", margin="0.02,0.02"];
  q2 -> q3 [xlabel="No"];
  s3_0 [shape=box, label="View 7- or\n30-day figures"];
  q3 -> s3_0 [xlabel="Yes"];
  r3 [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  s3_0 -> r3;
  {rank=same; q3; s3_0; r3}
  q4 [shape=diamond, fillcolor="#F4F4F4", label="Read farm\ninformation?", margin="0.02,0.02"];
  q3 -> q4 [xlabel="No"];
  s4_0 [shape=box, label="Read articles and\nannouncements"];
  q4 -> s4_0 [xlabel="Yes"];
  r4 [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  s4_0 -> r4;
  {rank=same; q4; s4_0; r4}
  q5 [shape=diamond, fillcolor="#F4F4F4", label="Reviews\nor chat?", margin="0.02,0.02"];
  q4 -> q5 [xlabel="No"];
  s5_0 [shape=box, label="View reviews;\nreport a review"];
  q5 -> s5_0 [xlabel="Yes"];
  s5_1 [shape=box, label="Chat about\nan order"];
  s5_0 -> s5_1;
  r5 [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  s5_1 -> r5;
  {rank=same; q5; s5_0; s5_1; r5}
  q5 -> lo [xlabel="No"];
  lo -> end;
  s [group=trunk];
  li [group=trunk];
  ok [group=trunk];
  home [group=trunk];
  lo [group=trunk];
  end [group=trunk];
  q0 [group=trunk];
  q1 [group=trunk];
  q2 [group=trunk];
  q3 [group=trunk];
  q4 [group=trunk];
  q5 [group=trunk];
}
