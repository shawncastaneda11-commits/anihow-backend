// Data flow diagram, level 1 (processes 1.0 to 4.0).
digraph G {
  graph [rankdir=LR, nodesep=0.25, ranksep=0.9, pad=0.25, fontname="Liberation Sans", newrank=true];
  node  [fontname="Liberation Sans", fontsize=11];
  edge  [penwidth=0.9, arrowsize=0.6, color="#333333", fontname="Liberation Sans", fontsize=8.5];
  p1 [shape=plaintext, margin=0, width=0, height=0, label=<<TABLE STYLE="ROUNDED" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F4F4F4"><TR><TD><FONT POINT-SIZE="10.5">1.0</FONT></TD></TR><HR/><TR><TD CELLPADDING="5"><FONT POINT-SIZE="10.5">Manage<BR/>Accounts and<BR/>Access</FONT></TD></TR></TABLE>>];
  by_p1 [shape=box, style=filled, fillcolor="#E8E6E0", penwidth=1.2, width=1.35, height=0.46, label="Buyer", comment="gsdup"];
  fs_p1 [shape=box, style=filled, fillcolor="#E8E6E0", penwidth=1.2, width=1.35, height=0.46, label="Farmer-Seller", comment="gsdup"];
  sa_p1 [shape=box, style=filled, fillcolor="#E1E6ED", penwidth=1.2, width=1.35, height=0.46, label="Super Admin", comment="gsdup"];
  ce_p1 [shape=box, style=filled, fillcolor="#E1E6ED", penwidth=1.2, width=1.35, height=0.46, label="Content Editor", comment="gsdup"];
  em_p1 [shape=box, style=filled, fillcolor="#F2F2F2", penwidth=1.2, width=1.35, height=0.46, label="Email Service", comment="gsdup"];
  D1_p1 [shape=plaintext, margin=0, width=0, height=0, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="L" WIDTH="3" CELLPADDING="0"></TD><TD SIDES="TBL" WIDTH="30"><B>D1</B></TD><TD SIDES="TB" ALIGN="LEFT">Users and Roles</TD></TR></TABLE>>];
  D16_p1 [shape=plaintext, margin=0, width=0, height=0, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D16</B></TD><TD SIDES="TB" ALIGN="LEFT">Codes and Reset Tokens</TD></TR></TABLE>>];
  p2 [shape=plaintext, margin=0, width=0, height=0, label=<<TABLE STYLE="ROUNDED" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F4F4F4"><TR><TD><FONT POINT-SIZE="10.5">2.0</FONT></TD></TR><HR/><TR><TD CELLPADDING="5"><FONT POINT-SIZE="10.5">Manage<BR/>Catalog and<BR/>Pricing</FONT></TD></TR></TABLE>>];
  fs_p2 [shape=box, style=filled, fillcolor="#E8E6E0", penwidth=1.2, width=1.35, height=0.46, label="Farmer-Seller", comment="gsdup"];
  sa_p2 [shape=box, style=filled, fillcolor="#E1E6ED", penwidth=1.2, width=1.35, height=0.46, label="Super Admin", comment="gsdup"];
  ce_p2 [shape=box, style=filled, fillcolor="#E1E6ED", penwidth=1.2, width=1.35, height=0.46, label="Content Editor", comment="gsdup"];
  D3_p2 [shape=plaintext, margin=0, width=0, height=0, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D3</B></TD><TD SIDES="TB" ALIGN="LEFT">Crop Types</TD></TR></TABLE>>];
  D2_p2 [shape=plaintext, margin=0, width=0, height=0, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="L" WIDTH="3" CELLPADDING="0"></TD><TD SIDES="TBL" WIDTH="30"><B>D2</B></TD><TD SIDES="TB" ALIGN="LEFT">Farms</TD></TR></TABLE>>];
  D4_p2 [shape=plaintext, margin=0, width=0, height=0, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="L" WIDTH="3" CELLPADDING="0"></TD><TD SIDES="TBL" WIDTH="30"><B>D4</B></TD><TD SIDES="TB" ALIGN="LEFT">Listings</TD></TR></TABLE>>];
  D8_p2 [shape=plaintext, margin=0, width=0, height=0, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="L" WIDTH="3" CELLPADDING="0"></TD><TD SIDES="TBL" WIDTH="30"><B>D8</B></TD><TD SIDES="TB" ALIGN="LEFT">Notifications</TD></TR></TABLE>>];
  p3 [shape=plaintext, margin=0, width=0, height=0, label=<<TABLE STYLE="ROUNDED" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F4F4F4"><TR><TD><FONT POINT-SIZE="10.5">3.0</FONT></TD></TR><HR/><TR><TD CELLPADDING="5"><FONT POINT-SIZE="10.5">Browse<BR/>Marketplace</FONT></TD></TR></TABLE>>];
  by_p3 [shape=box, style=filled, fillcolor="#E8E6E0", penwidth=1.2, width=1.35, height=0.46, label="Buyer", comment="gsdup"];
  fs_p3 [shape=box, style=filled, fillcolor="#E8E6E0", penwidth=1.2, width=1.35, height=0.46, label="Farmer-Seller", comment="gsdup"];
  D1_p3 [shape=plaintext, margin=0, width=0, height=0, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="L" WIDTH="3" CELLPADDING="0"></TD><TD SIDES="TBL" WIDTH="30"><B>D1</B></TD><TD SIDES="TB" ALIGN="LEFT">Users and Roles</TD></TR></TABLE>>];
  D2_p3 [shape=plaintext, margin=0, width=0, height=0, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="L" WIDTH="3" CELLPADDING="0"></TD><TD SIDES="TBL" WIDTH="30"><B>D2</B></TD><TD SIDES="TB" ALIGN="LEFT">Farms</TD></TR></TABLE>>];
  D4_p3 [shape=plaintext, margin=0, width=0, height=0, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="L" WIDTH="3" CELLPADDING="0"></TD><TD SIDES="TBL" WIDTH="30"><B>D4</B></TD><TD SIDES="TB" ALIGN="LEFT">Listings</TD></TR></TABLE>>];
  D9_p3 [shape=plaintext, margin=0, width=0, height=0, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="L" WIDTH="3" CELLPADDING="0"></TD><TD SIDES="TBL" WIDTH="30"><B>D9</B></TD><TD SIDES="TB" ALIGN="LEFT">Reviews</TD></TR></TABLE>>];
  D12_p3 [shape=plaintext, margin=0, width=0, height=0, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D12</B></TD><TD SIDES="TB" ALIGN="LEFT">Farm Announcements</TD></TR></TABLE>>];
  D10_p3 [shape=plaintext, margin=0, width=0, height=0, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D10</B></TD><TD SIDES="TB" ALIGN="LEFT">Favorites</TD></TR></TABLE>>];
  p4 [shape=plaintext, margin=0, width=0, height=0, label=<<TABLE STYLE="ROUNDED" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F4F4F4"><TR><TD><FONT POINT-SIZE="10.5">4.0</FONT></TD></TR><HR/><TR><TD CELLPADDING="5"><FONT POINT-SIZE="10.5">Process<BR/>Orders</FONT></TD></TR></TABLE>>];
  by_p4 [shape=box, style=filled, fillcolor="#E8E6E0", penwidth=1.2, width=1.35, height=0.46, label="Buyer", comment="gsdup"];
  fs_p4 [shape=box, style=filled, fillcolor="#E8E6E0", penwidth=1.2, width=1.35, height=0.46, label="Farmer-Seller", comment="gsdup"];
  sa_p4 [shape=box, style=filled, fillcolor="#E1E6ED", penwidth=1.2, width=1.35, height=0.46, label="Super Admin", comment="gsdup"];
  em_p4 [shape=box, style=filled, fillcolor="#F2F2F2", penwidth=1.2, width=1.35, height=0.46, label="Email Service", comment="gsdup"];
  D4_p4 [shape=plaintext, margin=0, width=0, height=0, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="L" WIDTH="3" CELLPADDING="0"></TD><TD SIDES="TBL" WIDTH="30"><B>D4</B></TD><TD SIDES="TB" ALIGN="LEFT">Listings</TD></TR></TABLE>>];
  D8_p4 [shape=plaintext, margin=0, width=0, height=0, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="L" WIDTH="3" CELLPADDING="0"></TD><TD SIDES="TBL" WIDTH="30"><B>D8</B></TD><TD SIDES="TB" ALIGN="LEFT">Notifications</TD></TR></TABLE>>];
  D9_p4 [shape=plaintext, margin=0, width=0, height=0, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="L" WIDTH="3" CELLPADDING="0"></TD><TD SIDES="TBL" WIDTH="30"><B>D9</B></TD><TD SIDES="TB" ALIGN="LEFT">Reviews</TD></TR></TABLE>>];
  sch_p4 [shape=box, style=filled, fillcolor="#F2F2F2", penwidth=1.2, width=1.35, height=0.46, label="Scheduler"];
  D5_p4 [shape=plaintext, margin=0, width=0, height=0, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D5</B></TD><TD SIDES="TB" ALIGN="LEFT">Cart Items</TD></TR></TABLE>>];
  D6_p4 [shape=plaintext, margin=0, width=0, height=0, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D6</B></TD><TD SIDES="TB" ALIGN="LEFT">Orders</TD></TR></TABLE>>];
  by_p1 -> p1 [label="registration, credentials,\nverification code"];
  fs_p1 -> p1 [label="credentials, password\nchanges"];
  sa_p1 -> p1 [label="farmer-seller and editor\naccounts, approvals,\nsuspensions"];
  by_p1 -> p1 [label="access token,\nverification status", dir=back];
  fs_p1 -> p1 [label="access token", dir=back];
  ce_p1 -> p1 [label="farm roster", dir=back];
  em_p1 -> p1 [label="verification codes,\npassword reset links", dir=back];
  p1 -> D1_p1 [label="accounts, roles, status"];
  p1 -> D1_p1 [label="stored accounts", dir=back];
  p1 -> D16_p1 [label="hashed codes, tokens"];
  p1 -> D16_p1 [label="code check", dir=back];
  sa_p2 -> p2 [label="crop types, system price\nguards, takedowns, restores"];
  ce_p2 -> p2 [label="farm price guards"];
  fs_p2 -> p2 [label="listings, photos,\ntawad rules"];
  fs_p2 -> p2 [label="effective floor,\nrejections", dir=back];
  p2 -> D3_p2 [label="crop types"];
  p2 -> D3_p2 [label="system guards", dir=back];
  p2 -> D2_p2 [label="farm overrides"];
  p2 -> D2_p2 [label="farm guards", dir=back];
  p2 -> D4_p2 [label="listings, tawad rules"];
  p2 -> D8_p2 [label="guard and takedown\nnotices"];
  by_p3 -> p3 [label="searches, favorites"];
  by_p3 -> p3 [label="listings, storefronts,\nfarm pages, reviews", dir=back];
  fs_p3 -> p3 [label="shop profile"];
  fs_p3 -> p3 [label="farm page,\nown shop reviews", dir=back];
  p3 -> D4_p3 [label="active listings", dir=back];
  p3 -> D2_p3 [label="farm profiles", dir=back];
  p3 -> D9_p3 [label="shop reviews", dir=back];
  p3 -> D12_p3 [label="public announcements", dir=back];
  p3 -> D10_p3 [label="favorites"];
  p3 -> D10_p3 [label="saved favorites", dir=back];
  p3 -> D1_p3 [label="shop profile"];
  by_p4 -> p4 [label="cart items, checkout,\ncancellations, reviews"];
  fs_p4 -> p4 [label="status updates,\nwalk-in sales"];
  by_p4 -> p4 [label="order status, receipts", dir=back];
  fs_p4 -> p4 [label="orders", dir=back];
  sch_p4 -> p4 [label="hourly sweep"];
  sa_p4 -> p4 [label="review removals"];
  sa_p4 -> p4 [label="order ledger", dir=back];
  p4 -> D5_p4 [label="cart items"];
  p4 -> D5_p4 [label="cart", dir=back];
  p4 -> D6_p4 [label="orders, status history"];
  p4 -> D6_p4 [label="order records", dir=back];
  p4 -> D4_p4 [label="stock held, deducted,\nreleased"];
  p4 -> D4_p4 [label="prices, tawad, stock", dir=back];
  p4 -> D9_p4 [label="reviews"];
  p4 -> D8_p4 [label="order notices"];
  em_p4 -> p4 [label="low-stock alerts", dir=back];
  {rank=same; by_p1; fs_p1; sa_p1; ce_p1; em_p1; sa_p2; ce_p2; fs_p2; by_p3; fs_p3; by_p4; fs_p4; sch_p4; sa_p4; em_p4}
  {rank=same; D1_p1; D16_p1; D3_p2; D2_p2; D4_p2; D8_p2; D4_p3; D2_p3; D9_p3; D12_p3; D10_p3; D1_p3; D5_p4; D6_p4; D4_p4; D9_p4; D8_p4}
  {rank=same; p1; p2; p3; p4}
  p1 -> p2 [style=invis, weight=10];
  p2 -> p3 [style=invis, weight=10];
  p3 -> p4 [style=invis, weight=10];
}
