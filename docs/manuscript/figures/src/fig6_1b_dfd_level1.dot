  p5 -> D7_p5 [label="messages"];
  p5 -> D7_p5 [label="threads", dir=back];
  p5 -> D8_p5 [label="notifications", dir=back];
  p5 -> D8_p5 [label="read status"];
  p5 -> D6_p5 [label="order parties", dir=back];
  ce_p6 -> p6 [label="profile, photos, articles,\nannouncements, farm answers"];
  sa_p6 -> p6 [label="system answers,\nmoderation"];
  fs_p6 -> p6 [label="questions"];
  by_p6 -> p6 [label="questions"];
  fs_p6 -> p6 [label="articles, announcements,\nanswers", dir=back];
  by_p6 -> p6 [label="answers", dir=back];
  ce_p6 -> p6 [label="moderation notices", dir=back];
  sch_p6 -> p6 [label="five-minute check"];
  p6 -> D2_p6 [label="profile, photos"];
  p6 -> D11_p6 [label="articles"];
  p6 -> D11_p6 [label="published articles", dir=back];
  p6 -> D12_p6 [label="announcements"];
  p6 -> D12_p6 [label="due announcements", dir=back];
  p6 -> D13_p6 [label="answers"];
  p6 -> D13_p6 [label="matching answers", dir=back];
  p6 -> D8_p6 [label="announcement notices"];
  p7 -> D6_p7 [label="completed orders", dir=back];
  sa_p7 -> p7 [label="system analytics,\nCSV exports, export log", dir=back];
  ce_p7 -> p7 [label="farm analytics", dir=back];
  fs_p7 -> p7 [label="My Sales", dir=back];
  sa_p7 -> p7 [label="export requests"];
  p7 -> D14_p7 [label="export entries"];
  p7 -> D14_p7 [label="export history", dir=back];
  by_p8 -> p8 [label="corrections, download\nand deletion requests"];
  fs_p8 -> p8 [label="corrections, download\nand deletion requests"];
