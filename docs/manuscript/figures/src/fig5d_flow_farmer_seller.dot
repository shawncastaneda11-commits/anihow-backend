digraph G {
  graph [rankdir=TB, nodesep=0.5, ranksep=0.6, pad=0.4, fontname="Liberation Sans", newrank=true, splines=polyline, bgcolor="white"];
  node  [fontname="Liberation Sans", fontsize=12, penwidth=1, color="#333333", style=filled, fillcolor="#FFFFFF", margin="0.26,0.16"];
  edge  [penwidth=1, arrowsize=0.7, color="#333333", fontname="Liberation Sans", fontsize=11];
  s [shape=box, style="rounded,filled", fillcolor="#F8F9FA", width=1.3, height=0.5, margin="0.2,0.1", label="Start"];
  li [shape=parallelogram, fillcolor="#F8F9FA", label="Log in to the\napp", margin="0.30,0.12"];
  ok [shape=diamond, fillcolor="#FFFFFF", label="Credentials valid\nand account active?", margin="0.20,0.10"];
  err [shape=box, label="Show error message"];
  ain [shape=circle, width=0.5, fixedsize=true, fillcolor="#F8F9FA", label="R"];
  home [shape=box, label="Farmer-seller\nhome"];
  lo [shape=box, label="Log out"];
  end [shape=box, style="rounded,filled", fillcolor="#F8F9FA", width=1.3, height=0.5, margin="0.2,0.1", label="End"];
  s -> li;
  li -> ok;
  ok -> err [label="No"];
  err -> li [constraint=false];
  ok -> home [label="Yes"];
  ain -> home;
  {rank=same; ok err}
  {rank=same; home ain}
  q0 [shape=diamond, fillcolor="#FFFFFF", label="Manage\nlistings?", margin="0.20,0.10"];
  home -> q0;
  s0_0 [shape=parallelogram, fillcolor="#F8F9FA", label="Enter price, stock,\nand photos", margin="0.30,0.12"];
  q0 -> s0_0 [label="Yes"];
  s0_1 [shape=diamond, fillcolor="#FFFFFF", label="At or above\nthe floor?", margin="0.20,0.10"];
  s0_0 -> s0_1;
  a0_1 [shape=box, label="Show the\nfloor price"];
  xa0_1 [shape=circle, width=0.5, fixedsize=true, fillcolor="#F8F9FA", label="R"];
  s0_1 -> a0_1 [label="No"];
  a0_1 -> xa0_1;
  {rank=same; a0_1; xa0_1}
  s0_2 [shape=box, label="Publish with\noptional tawad"];
  s0_1 -> s0_2 [label="Yes"];
  r0 [shape=circle, width=0.5, fixedsize=true, fillcolor="#F8F9FA", label="R"];
  s0_2 -> r0;
  {rank=same; q0; s0_0; s0_1; s0_2; r0}
  q1 [shape=diamond, fillcolor="#FFFFFF", label="Process\norders?", margin="0.20,0.10"];
  q0 -> q1 [label="No", minlen=2];
  s1_0 [shape=diamond, fillcolor="#FFFFFF", label="Accept the\norder?", margin="0.20,0.10"];
  q1 -> s1_0 [label="Yes"];
  a1_0 [shape=box, label="Cancel with reason;\nstock released"];
  xa1_0 [shape=circle, width=0.5, fixedsize=true, fillcolor="#F8F9FA", label="R"];
  s1_0 -> a1_0 [label="No"];
  a1_0 -> xa1_0;
  {rank=same; a1_0; xa1_0}
  s1_1 [shape=box, label="Confirm, mark\nReady, hand over"];
  s1_0 -> s1_1 [label="Yes"];
  s1_2 [shape=parallelogram, fillcolor="#F8F9FA", label="Complete with\namount received", margin="0.30,0.12"];
  s1_1 -> s1_2;
  r1 [shape=circle, width=0.5, fixedsize=true, fillcolor="#F8F9FA", label="R"];
  s1_2 -> r1;
  {rank=same; q1; s1_0; s1_1; s1_2; r1}
  q2 [shape=diamond, fillcolor="#FFFFFF", label="Walk-in\nsale?", margin="0.20,0.10"];
  q1 -> q2 [label="No", minlen=2];
  s2_0 [shape=parallelogram, fillcolor="#F8F9FA", label="Enter listing,\nquantity, amount", margin="0.30,0.12"];
  q2 -> s2_0 [label="Yes"];
  s2_1 [shape=box, label="Saved at\nCompleted"];
  s2_0 -> s2_1;
  r2 [shape=circle, width=0.5, fixedsize=true, fillcolor="#F8F9FA", label="R"];
  s2_1 -> r2;
  {rank=same; q2; s2_0; s2_1; r2}
  q3 [shape=diamond, fillcolor="#FFFFFF", label="View My\nSales?", margin="0.20,0.10"];
  q2 -> q3 [label="No"];
  s3_0 [shape=box, label="View 7- or\n30-day figures"];
  q3 -> s3_0 [label="Yes"];
  r3 [shape=circle, width=0.5, fixedsize=true, fillcolor="#F8F9FA", label="R"];
  s3_0 -> r3;
  {rank=same; q3; s3_0; r3}
  q4 [shape=diamond, fillcolor="#FFFFFF", label="Read farm\ninformation?", margin="0.20,0.10"];
  q3 -> q4 [label="No"];
  s4_0 [shape=box, label="Read articles and\nannouncements"];
  q4 -> s4_0 [label="Yes"];
  r4 [shape=circle, width=0.5, fixedsize=true, fillcolor="#F8F9FA", label="R"];
  s4_0 -> r4;
  {rank=same; q4; s4_0; r4}
  q5 [shape=diamond, fillcolor="#FFFFFF", label="Reviews\nor chat?", margin="0.20,0.10"];
  q4 -> q5 [label="No"];
  s5_0 [shape=box, label="View reviews;\nreport a review"];
  q5 -> s5_0 [label="Yes"];
  s5_1 [shape=box, label="Chat about\nan order"];
  s5_0 -> s5_1;
  r5 [shape=circle, width=0.5, fixedsize=true, fillcolor="#F8F9FA", label="R"];
  s5_1 -> r5;
  {rank=same; q5; s5_0; s5_1; r5}
  q5 -> lo [label="No"];
  lo -> end;
  s [group=trunk];
  li [group=trunk];
  ok [group=trunk];
  home [group=trunk];
  lo [group=trunk];
  end [group=trunk];
  q0 [group=trunk];
  q1 [group=trunk];
  q2 [group=trunk];
  q3 [group=trunk];
  q4 [group=trunk];
  q5 [group=trunk];
}
