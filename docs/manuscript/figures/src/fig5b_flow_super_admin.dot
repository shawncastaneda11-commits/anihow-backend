digraph G {
  graph [rankdir=TB, nodesep=0.45, ranksep=0.5, pad=0.2, fontname="Liberation Sans", newrank=true, splines=ortho];
  node  [fontname="Liberation Sans", fontsize=14, penwidth=1.3, style=filled, fillcolor="#FFFFFF", margin="0.12,0.06"];
  edge  [penwidth=1.1, arrowsize=0.7, color="#333333", fontname="Liberation Sans", fontsize=12];
  s [shape=box, style="rounded,filled", fillcolor="#E1E6ED", label="Start"];
  li [shape=parallelogram, fillcolor="#F2F2F2", label="Log in to the\nCMS", margin="0.02,0.04"];
  ok [shape=diamond, fillcolor="#F4F4F4", label="Credentials valid\nand account active?", margin="0.02,0.02"];
  err [shape=box, label="Show error message"];
  ain [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  home [shape=box, label="Super Admin\ndashboard"];
  lo [shape=box, label="Log out"];
  end [shape=box, style="rounded,filled", fillcolor="#E1E6ED", label="End"];
  s -> li;
  li -> ok;
  ok -> err [xlabel="No"];
  err -> li [constraint=false];
  ok -> home [xlabel="Yes"];
  ain -> home;
  {rank=same; ok err}
  {rank=same; home ain}
  q0 [shape=diamond, fillcolor="#F4F4F4", label="Manage\naccounts?", margin="0.02,0.02"];
  home -> q0;
  s0_0 [shape=box, label="Create, approve, or\nsuspend an account"];
  q0 -> s0_0 [xlabel="Yes"];
  s0_1 [shape=box, label="Save the\naccount"];
  s0_0 -> s0_1;
  r0 [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  s0_1 -> r0;
  {rank=same; q0; s0_0; s0_1; r0}
  q1 [shape=diamond, fillcolor="#F4F4F4", label="Edit crop\ntaxonomy?", margin="0.02,0.02"];
  q0 -> q1 [xlabel="No"];
  s1_0 [shape=parallelogram, fillcolor="#F2F2F2", label="Enter floor price\nand discount", margin="0.02,0.04"];
  q1 -> s1_0 [xlabel="Yes"];
  s1_1 [shape=diamond, fillcolor="#F4F4F4", label="Values\nvalid?", margin="0.02,0.02"];
  s1_0 -> s1_1;
  a1_1 [shape=box, label="Show\nerror"];
  xa1_1 [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  s1_1 -> a1_1 [xlabel="No"];
  a1_1 -> xa1_1;
  {rank=same; a1_1; xa1_1}
  s1_2 [shape=box, label="Save; notify\nsellers"];
  s1_1 -> s1_2 [xlabel="Yes"];
  r1 [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  s1_2 -> r1;
  {rank=same; q1; s1_0; s1_1; s1_2; r1}
  q2 [shape=diamond, fillcolor="#F4F4F4", label="Moderate\ncontent?", margin="0.02,0.02"];
  q1 -> q2 [xlabel="No", minlen=2];
  s2_0 [shape=box, label="Review listings,\nreviews, answers"];
  q2 -> s2_0 [xlabel="Yes"];
  s2_1 [shape=box, label="Take down, remove,\nor deactivate"];
  s2_0 -> s2_1;
  r2 [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  s2_1 -> r2;
  {rank=same; q2; s2_0; s2_1; r2}
  q3 [shape=diamond, fillcolor="#F4F4F4", label="Handle a\nreport?", margin="0.02,0.02"];
  q2 -> q3 [xlabel="No"];
  s3_0 [shape=box, label="Open the\nreport"];
  q3 -> s3_0 [xlabel="Yes"];
  s3_1 [shape=diamond, fillcolor="#F4F4F4", label="Action\nwarranted?", margin="0.02,0.02"];
  s3_0 -> s3_1;
  a3_1 [shape=box, label="Dismiss;\nnotify reporter"];
  xa3_1 [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  s3_1 -> a3_1 [xlabel="No"];
  a3_1 -> xa3_1;
  {rank=same; a3_1; xa3_1}
  s3_2 [shape=box, label="Resolve; take down\nor remove"];
  s3_1 -> s3_2 [xlabel="Yes"];
  r3 [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  s3_2 -> r3;
  {rank=same; q3; s3_0; s3_1; s3_2; r3}
  q4 [shape=diamond, fillcolor="#F4F4F4", label="Deletion\nrequest?", margin="0.02,0.02"];
  q3 -> q4 [xlabel="No", minlen=2];
  s4_0 [shape=box, label="Open the\nrequest"];
  q4 -> s4_0 [xlabel="Yes"];
  s4_1 [shape=diamond, fillcolor="#F4F4F4", label="No open orders\nand approved?", margin="0.02,0.02"];
  s4_0 -> s4_1;
  a4_1 [shape=box, label="Reject;\nnotify user"];
  xa4_1 [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  s4_1 -> a4_1 [xlabel="No"];
  a4_1 -> xa4_1;
  {rank=same; a4_1; xa4_1}
  s4_2 [shape=box, label="Anonymize;\nemail notice"];
  s4_1 -> s4_2 [xlabel="Yes"];
  r4 [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  s4_2 -> r4;
  {rank=same; q4; s4_0; s4_1; s4_2; r4}
  q5 [shape=diamond, fillcolor="#F4F4F4", label="View\nrecords?", margin="0.02,0.02"];
  q4 -> q5 [xlabel="No", minlen=2];
  s5_0 [shape=box, label="View ledger, chats,\nand analytics"];
  q5 -> s5_0 [xlabel="Yes"];
  s5_1 [shape=parallelogram, fillcolor="#F2F2F2", label="Export CSV\n(logged)", margin="0.02,0.04"];
  s5_0 -> s5_1;
  r5 [shape=circle, width=0.35, fixedsize=true, fillcolor="#E8E6E0", label="R"];
  s5_1 -> r5;
  {rank=same; q5; s5_0; s5_1; r5}
  q5 -> lo [xlabel="No"];
  lo -> end;
  s [group=trunk];
  li [group=trunk];
  ok [group=trunk];
  home [group=trunk];
  lo [group=trunk];
  end [group=trunk];
  q0 [group=trunk];
  q1 [group=trunk];
  q2 [group=trunk];
  q3 [group=trunk];
  q4 [group=trunk];
  q5 [group=trunk];
}
