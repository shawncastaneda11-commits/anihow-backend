// Data flow diagram, level 2, process 2.0 Manage Catalog and Pricing.
digraph G {
  graph [rankdir=LR, nodesep=0.25, ranksep=0.9, pad=0.25, fontname="Liberation Sans", newrank=true];
  node  [fontname="Liberation Sans", fontsize=11];
  edge  [penwidth=0.9, arrowsize=0.6, color="#333333", fontname="Liberation Sans", fontsize=8.5];
  q2a [shape=circle, style=filled, fillcolor="#F4F4F4", penwidth=1.4, fixedsize=true, width=1.35, fontsize=10.5, label="2.1\n\nMaintain\nCrop\nTaxonomy"];
  sa_q2a [shape=box, style=filled, fillcolor="#E1E6ED", penwidth=1.2, width=1.35, height=0.42, label="Super Admin*"];
  D3_q2a [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D3</B></TD><TD SIDES="TB" ALIGN="LEFT">Crop Types*</TD></TR></TABLE>>];
  q2b [shape=circle, style=filled, fillcolor="#F4F4F4", penwidth=1.4, fixedsize=true, width=1.35, fontsize=10.5, label="2.2\n\nSet Farm\nPrice\nGuards"];
  sa_q2b [shape=box, style=filled, fillcolor="#E1E6ED", penwidth=1.2, width=1.35, height=0.42, label="Super Admin*"];
  D3_q2b [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D3</B></TD><TD SIDES="TB" ALIGN="LEFT">Crop Types*</TD></TR></TABLE>>];
  ce_q2b [shape=box, style=filled, fillcolor="#E1E6ED", penwidth=1.2, width=1.35, height=0.42, label="Content Editor"];
  D2_q2b [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D2</B></TD><TD SIDES="TB" ALIGN="LEFT">Farms*</TD></TR></TABLE>>];
  D4_q2b [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D4</B></TD><TD SIDES="TB" ALIGN="LEFT">Listings*</TD></TR></TABLE>>];
  D8_q2b [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D8</B></TD><TD SIDES="TB" ALIGN="LEFT">Notifications*</TD></TR></TABLE>>];
  q2c [shape=circle, style=filled, fillcolor="#F4F4F4", penwidth=1.4, fixedsize=true, width=1.35, fontsize=10.5, label="2.3\n\nManage\nListings"];
  D3_q2c [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D3</B></TD><TD SIDES="TB" ALIGN="LEFT">Crop Types*</TD></TR></TABLE>>];
  D2_q2c [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D2</B></TD><TD SIDES="TB" ALIGN="LEFT">Farms*</TD></TR></TABLE>>];
  D4_q2c [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D4</B></TD><TD SIDES="TB" ALIGN="LEFT">Listings*</TD></TR></TABLE>>];
  fs_q2c [shape=box, style=filled, fillcolor="#E8E6E0", penwidth=1.2, width=1.35, height=0.42, label="Farmer-Seller*"];
  q2d [shape=circle, style=filled, fillcolor="#F4F4F4", penwidth=1.4, fixedsize=true, width=1.35, fontsize=10.5, label="2.4\n\nManage\nTawad\nRules"];
  D3_q2d [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D3</B></TD><TD SIDES="TB" ALIGN="LEFT">Crop Types*</TD></TR></TABLE>>];
  D2_q2d [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D2</B></TD><TD SIDES="TB" ALIGN="LEFT">Farms*</TD></TR></TABLE>>];
  D4_q2d [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D4</B></TD><TD SIDES="TB" ALIGN="LEFT">Listings*</TD></TR></TABLE>>];
  fs_q2d [shape=box, style=filled, fillcolor="#E8E6E0", penwidth=1.2, width=1.35, height=0.42, label="Farmer-Seller*"];
  q2e [shape=circle, style=filled, fillcolor="#F4F4F4", penwidth=1.4, fixedsize=true, width=1.35, fontsize=10.5, label="2.5\n\nModerate\nListings"];
  sa_q2e [shape=box, style=filled, fillcolor="#E1E6ED", penwidth=1.2, width=1.35, height=0.42, label="Super Admin*"];
  D4_q2e [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D4</B></TD><TD SIDES="TB" ALIGN="LEFT">Listings*</TD></TR></TABLE>>];
  D8_q2e [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD SIDES="TBL" WIDTH="30"><B>D8</B></TD><TD SIDES="TB" ALIGN="LEFT">Notifications*</TD></TR></TABLE>>];
  sa_q2a -> q2a [label="crop types, system floor\nand maximum discount"];
  q2a -> D3_q2a [label="crop types, guards"];
  q2a -> q2b [label="system guards", constraint=false];
  ce_q2b -> q2b [label="own farm floor\nand ceiling"];
  sa_q2b -> q2b [label="any farm floor\nand ceiling"];
  q2b -> D3_q2b [label="system guards", dir=back];
  q2b -> D2_q2b [label="tighten-only overrides"];
  q2b -> D4_q2b [label="affected listings", dir=back];
  q2b -> D8_q2b [label="stranded listing\nand tawad notices"];
  fs_q2c -> q2c [label="listing details, photos,\npause or resume"];
  q2c -> D3_q2c [label="system floor", dir=back];
  q2c -> D2_q2c [label="farm floor", dir=back];
  q2c -> D4_q2c [label="listings, photos,\nthumbnails"];
  fs_q2c -> q2c [label="effective floor,\nrejections", dir=back];
  fs_q2d -> q2d [label="flat or quantity\ntawad rules"];
  q2d -> D3_q2d [label="maximum discount", dir=back];
  q2d -> D2_q2d [label="farm ceiling", dir=back];
  q2d -> D4_q2d [label="tawad rules"];
  fs_q2d -> q2d [label="rejections", dir=back];
  sa_q2e -> q2e [label="takedown, restore"];
  q2e -> D4_q2e [label="listing status"];
  q2e -> D8_q2e [label="takedown and\nrestore notices"];
  {rank=same; sa_q2a; ce_q2b; sa_q2b; fs_q2c; fs_q2d; sa_q2e}
  {rank=same; D3_q2a; D3_q2b; D2_q2b; D4_q2b; D8_q2b; D3_q2c; D2_q2c; D4_q2c; D3_q2d; D2_q2d; D4_q2d; D4_q2e; D8_q2e}
  {rank=same; q2a; q2b; q2c; q2d; q2e}
  q2a -> q2b [style=invis, weight=10];
  q2b -> q2c [style=invis, weight=10];
  q2c -> q2d [style=invis, weight=10];
  q2d -> q2e [style=invis, weight=10];
}
